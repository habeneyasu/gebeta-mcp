# Copy to .env and adjust. Every variable is optional; the values shown are the defaults.

# Rule limits (spec §5.1, §11.2), applied to games created after startup.
GEBETA_MAX_DROPS=10000
GEBETA_MAX_MOVES_WITHOUT_CAPTURE=20

# FastAPI server.
GEBETA_HOST=127.0.0.1
GEBETA_PORT=8000

# Claude agent (requires the `llm` extra).
GEBETA_CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
